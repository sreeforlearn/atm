# ============================================================
# .env.example — copy to .env and adjust values before running
# `docker compose up`. NEVER commit the real .env to git.
# ============================================================

# ---- Postgres ----
POSTGRES_USER=atm
POSTGRES_PASSWORD=atm123
POSTGRES_DB=atmdb

# ---- JWT (256-bit / 32-byte secret, base64-encoded for portability) ----
# Generate fresh with:  openssl rand -base64 32
JWT_SECRET=YjRiNGQ2MzE4OTlkY2Y0MmM3NmQ2YjY5NDc5NTI2YjUyMzM5MzQ4NjM2NjU2MTY1NjQ2MTY1NjM2NTY1NjQ2MQ==

# ---- Docker Hub ----
DOCKER_USERNAME=yourusername

# ---- Service ports (already mirrored in docker-compose.yml) ----
AUTH_SERVICE_PORT=8081
ACCOUNT_SERVICE_PORT=8082
TRANSACTION_SERVICE_PORT=8083
CARD_SERVICE_PORT=8084
API_GATEWAY_PORT=8080
FRONTEND_PORT=80

# ---- Kafka (dev defaults) ----
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_TRANSACTIONS=atm.transactions
KAFKA_TOPIC_AUDIT=atm.audit
